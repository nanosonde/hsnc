# Example environment for running hsnc against REAL devices.
#
# Copy this file to `.env` next to docker-compose.yml and fill in your values:
#     cp .env.example .env
#
# docker-compose.yml loads `.env` via `env_file:`, so these values are injected
# into the container's environment where the app reads them. `.env` is
# git-ignored — never commit your real passwords.
#
# This file only needs the SECRETS and any non-default toggles; the image
# already ships sensible defaults for everything else (see the env table in
# README.md). Before starting, also create your device inventory:
#     cp config/devices.yaml.example config/devices.yaml   # then edit

# ---------------------------------------------------------------------------
# Flask session secret — REQUIRED in production. Use a long random value, e.g.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# ---------------------------------------------------------------------------
HSNC_SECRET_KEY=change-me-to-a-long-random-value

# ---------------------------------------------------------------------------
# Real devices (the bundled compose file already sets HSNC_USE_MOCK_DEVICES=0).
# Set this here too if you run the image directly with `docker run`.
# ---------------------------------------------------------------------------
HSNC_USE_MOCK_DEVICES=0

# ---------------------------------------------------------------------------
# SSH passwords for real-device mode. Resolved ONLY from the environment, never
# from config/devices.yaml. Per-device host/port/username come from the
# `connection:` block in devices.yaml.
#
# Platform fallbacks (applied when a device has no per-device password set):
# ---------------------------------------------------------------------------
HSNC_OPENWRT_SSH_PASSWORD=your-openwrt-password
HSNC_JETSTREAM_SSH_PASSWORD=your-jetstream-password

# Per-device override (takes precedence over the platform fallback). The id is
# upper-cased with non-alphanumeric characters replaced by `_`, e.g. device
# id `gateway-1` -> HSNC_DEVICE_GATEWAY_1_PASSWORD.
# HSNC_DEVICE_GATEWAY_1_PASSWORD=per-device-password

# SSH host-key handling. Default 1 auto-accepts unknown host keys on first
# connect; set to 0 to reject unknown keys (stricter).
# HSNC_SSH_ACCEPT_UNKNOWN_HOSTS=1

# Force a single host/IP for every device (handy for lab testing against one
# target). Leave unset in normal operation.
# HSNC_SSH_HOST_OVERRIDE=127.0.0.1

# ---------------------------------------------------------------------------
# Optional behaviour toggles (defaults shown; uncomment to override).
# ---------------------------------------------------------------------------
# On startup read each device's live config as the history baseline. Set to 0
# if the controller is the sole source of truth and devices are never changed
# out-of-band.
# HSNC_BASELINE_ON_START=1

# Backend poll-cycle interval, in seconds.
# HSNC_POLL_INTERVAL=30

# Drop runtime telemetry rows older than N days (0 disables pruning).
# HSNC_RETENTION_DAYS=30

# Application log verbosity: debug, info, warning, error, critical.
# HSNC_LOG_LEVEL=info

# Bearer token the backend requires and the frontend sends. Leave unset for no
# API auth (the two processes share localhost inside the container).
# HSNC_API_TOKEN=
