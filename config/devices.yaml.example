# Example device inventory — CONNECTION/IDENTITY ONLY.
#
# Copy this file to `devices.yaml` and edit it for your environment:
#     cp config/devices.yaml.example config/devices.yaml
#
# In Docker the seed-config step copies this template to `devices.yaml`
# automatically on first run if one is not already present.
#
# This file describes only HOW to reach each device. The running/desired
# configuration (VLANs, ports, SSIDs, model, firmware) is NOT stored here — the
# REST backend reads it from the hardware into `data/current_config.json`
# (the baseline) and the UI stages edits in `data/desired_config.json`.
#
# kind: gateway | switch | access_point
# connection: SSH details (passwords come from the environment, never this file)
# monitoring:  live runtime-polling. The configuration plane is always SSH; the
#   monitoring plane NEVER uses SSH. The transport is fixed by platform —
#   OpenWrt gateways/APs are scraped over a Prometheus node-exporter and
#   JetStream switches over SNMPv3 — so there is nothing to select here:
#     enabled:  poll the device for live data (default true; false -> "unknown")
#     endpoint: optional override. When omitted it is derived from the device IP
#               (http://<ip>:9100/metrics for Prometheus, <ip>:161 for SNMP).
#     port:     optional SNMP UDP port (default 161; ignored for Prometheus).
#   Secrets (SNMPv3 keys, Prometheus token) are NEVER stored here — they come
#   from the environment. See docs/devices/ for per-platform setup.
devices:
  - id: gateway-1
    name: ER605
    kind: gateway
    ip: 192.168.50.254
    site_id: default
    connection:
      username: root
      port: 22
    # OpenWrt -> Prometheus exporter; endpoint derived from the IP by default.
    monitoring:
      enabled: true

  - id: switch-1
    name: TL-SG2210P
    kind: switch
    ip: 192.168.50.2
    site_id: default
    connection:
      username: admin
      port: 22
    # JetStream -> SNMPv3; host/port derived from the IP by default. Override
    # the endpoint/port explicitly if the switch answers SNMP elsewhere:
    #   endpoint: 192.168.50.2
    #   port: 161
    monitoring:
      enabled: true

  - id: ap-1
    name: EAP245
    kind: access_point
    ip: 192.168.50.3
    site_id: default
    connection:
      username: root
      port: 22
    # OpenWrt -> Prometheus exporter. Override the endpoint if it is not the
    # default http://<ip>:9100/metrics:
    #   endpoint: http://192.168.50.3:9100/metrics
    monitoring:
      enabled: true

  - id: switch-2
    name: GS1900-OWRT
    kind: switch
    ip: 192.168.50.4
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      enabled: true
