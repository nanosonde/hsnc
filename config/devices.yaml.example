# Example device inventory — CONNECTION/IDENTITY ONLY.
#
# Copy this file to `devices.yaml` and edit it for your environment:
#     cp config/devices.yaml.example config/devices.yaml
#
# In Docker the seed-config step copies this template to `devices.yaml`
# automatically on first run if one is not already present.
#
# This file describes only HOW to reach each device. The running/desired
# configuration (VLANs, ports, SSIDs, model, firmware) is NOT stored here — the
# Device Broker reads it from the hardware into `data/current_config.json`
# (the baseline) and the UI stages edits in `data/desired_config.json`.
#
# kind: gateway | switch | access_point
# connection: SSH details (passwords come from the environment, never this file)
# monitoring: live-data channel — type: ssh | snmp | prometheus | none
devices:
  - id: gateway-1
    name: ER605
    kind: gateway
    ip: 192.168.50.254
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      type: ssh

  - id: switch-1
    name: TL-SG2210P
    kind: switch
    ip: 192.168.50.2
    site_id: default
    connection:
      username: admin
      port: 22
    monitoring:
      type: ssh

  - id: ap-1
    name: EAP245
    kind: access_point
    ip: 192.168.50.3
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      type: ssh

  - id: switch-2
    name: GS1900-OWRT
    kind: switch
    ip: 192.168.50.4
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      type: ssh
