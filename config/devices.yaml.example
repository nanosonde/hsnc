# Example device inventory — CONNECTION/IDENTITY ONLY.
#
# Copy this file to `devices.yaml` and edit it for your environment:
#     cp config/devices.yaml.example config/devices.yaml
#
# In Docker the seed-config step copies this template to `devices.yaml`
# automatically on first run if one is not already present.
#
# This file describes only HOW to reach each device. The running/desired
# configuration (VLANs, ports, SSIDs, model, firmware) is NOT stored here — the
# REST backend reads it from the hardware into `data/current_config.json`
# (the baseline) and the UI stages edits in `data/desired_config.json`.
#
# kind: gateway | switch | access_point
# connection: SSH details (passwords come from the environment, never this file)
# monitoring:  live runtime-polling channel. Configuration is always over SSH;
#   this only selects where live status/clients are read from:
#     source: primary | secondary | none   (default: primary)
#       primary   -> scrape over SSH (OpenWrt ubus / JetStream CLI)
#       secondary -> use the per-device `secondary` channel below
#       none      -> disable live polling (device shows "unknown")
#     secondary:                            (only used when source: secondary)
#       type: prometheus | snmp
#       endpoint: prometheus URL, or SNMP host[:port]
#       port: SNMP UDP port (default 161; ignored for prometheus)
#   Secrets (SNMPv3 keys, Prometheus token) are NEVER stored here — they come
#   from the environment. See docs/devices/ for per-platform setup.
devices:
  - id: gateway-1
    name: ER605
    kind: gateway
    ip: 192.168.50.254
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      source: primary

  - id: switch-1
    name: TL-SG2210P
    kind: switch
    ip: 192.168.50.2
    site_id: default
    connection:
      username: admin
      port: 22
    monitoring:
      source: primary
    # Secondary polling over SNMPv3 (see docs/devices/jetstream.md):
    #   source: secondary
    #   secondary:
    #     type: snmp
    #     endpoint: 192.168.50.2
    #     port: 161

  - id: ap-1
    name: EAP245
    kind: access_point
    ip: 192.168.50.3
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      source: primary
    # Secondary polling over a Prometheus exporter (see docs/devices/openwrt.md):
    #   source: secondary
    #   secondary:
    #     type: prometheus
    #     endpoint: http://192.168.50.3:9100/metrics

  - id: switch-2
    name: GS1900-OWRT
    kind: switch
    ip: 192.168.50.4
    site_id: default
    connection:
      username: root
      port: 22
    monitoring:
      source: primary
