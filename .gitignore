# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
coverage.xml

# Runtime data (config + sqlite live under data/ at runtime)
/data/*.db
/data/*.db-*
/data/*.sock
/data/backups/
/data/desired_config.json
/data/current_config.json
/data/config-backups/

# Runtime data when the backend runs from inside the package (default data dir
# resolves to hsnc/data/)
/hsnc/data/*.db
/hsnc/data/*.db-*
/hsnc/data/*.sock
/hsnc/data/backups/
/hsnc/data/desired_config.json
/hsnc/data/current_config.json
/hsnc/data/history.jsonl
/hsnc/data/config-backups/

# Local device inventory (copied from config/devices.yaml.example)
/config/devices.yaml

# Local environment / secrets
.env

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store

# Logs
*.log
